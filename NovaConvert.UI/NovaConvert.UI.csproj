<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\Brand\nova-logo.ico</ApplicationIcon>
    <AssemblyName>NovaConvert</AssemblyName>
    <RootNamespace>NovaConvert.UI</RootNamespace>
    <Version>1.0.0</Version>
    <Product>NOVA Convert</Product>
    <Company>NOVA Software</Company>
    <Description>Every format. One place.</Description>
    <Copyright>Copyright © 2026 NOVA Software. All rights reserved.</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NovaConvert.Core\NovaConvert.Core.csproj" />
    <ProjectReference Include="..\NovaConvert.Engines\NovaConvert.Engines.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Brand\nova-logo.png" />
    <Resource Include="Assets\Brand\nova-logo-white.png" />
    <Resource Include="Assets\Brand\nova-logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Update="..\engines\ffmpeg\**\*.*">
      <Link>engines\ffmpeg\%(RecursiveDir)%(FileName)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
